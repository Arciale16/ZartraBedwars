{
    "schema_version": 1,
    "policy": {
        "functional_modules_materialized_in_m01": 0,
        "platform_imports_forbidden_in": [
            "api",
            "domain",
            "application",
            "config"
        ],
        "cycles_allowed": false,
        "unlisted_module_dependencies_allowed": false,
        "later_milestone_dependencies_allowed": false
    },
    "materialized_build_modules": [
        {
            "id": "zartrabedwars-parent",
            "path": "pom.xml",
            "packaging": "pom",
            "responsibility": "reactor and approved plugin version governance"
        },
        {
            "id": "zbw-bom",
            "path": "build/zbw-bom/pom.xml",
            "packaging": "pom",
            "responsibility": "approved exact dependency selections"
        },
        {
            "id": "zbw-build-tools",
            "path": "build/zbw-build-tools/pom.xml",
            "packaging": "pom",
            "responsibility": "deterministic build-governance descriptor"
        },
        {
            "id": "zbw-api",
            "path": "api/zbw-api/pom.xml",
            "packaging": "jar",
            "responsibility": "versioned public contracts and platform-neutral primitives"
        },
        {
            "id": "zbw-domain",
            "path": "domain/zbw-domain/pom.xml",
            "packaging": "jar",
            "responsibility": "platform-neutral generator and private-game domain contracts"
        },
        {
            "id": "zbw-application",
            "path": "application/zbw-application/pom.xml",
            "packaging": "jar",
            "responsibility": "immutable content and provider capability policies"
        },
        {
            "id": "zbw-config",
            "path": "configuration/zbw-config/pom.xml",
            "packaging": "jar",
            "responsibility": "typed configuration, migration, reload, localization, authorization, secret and validation foundations"
        },
        {
            "id": "zbw-observability",
            "path": "observability/zbw-observability/pom.xml",
            "packaging": "jar",
            "responsibility": "bounded health, metrics, diagnostics and Plugin Doctor runtime substrate"
        },
        {
            "id": "zbw-storage-api",
            "path": "storage/zbw-storage-api/pom.xml",
            "packaging": "jar",
            "responsibility": "JDBC-free repository, unit-of-work, migration, mutation, cache, retention and recovery contracts"
        },
        {
            "id": "zbw-storage-sql",
            "path": "storage/zbw-storage-sql/pom.xml",
            "packaging": "jar",
            "responsibility": "SQLite, MySQL and MariaDB storage adapters, migrations, outbox/inbox, cache and recovery foundations"
        },
        {
            "id": "zbw-sdk",
            "path": "sdk/zbw-sdk/pom.xml",
            "packaging": "jar",
            "responsibility": "extension metadata reader and deterministic validator"
        },
        {
            "id": "zbw-integration-discord-api",
            "path": "integrations/discord/zbw-integration-discord-api/pom.xml",
            "packaging": "jar",
            "responsibility": "optional Discord provider and integration contracts"
        },
        {
            "id": "zbw-integration-placeholderapi-api",
            "path": "integrations/placeholderapi/zbw-integration-placeholderapi-api/pom.xml",
            "packaging": "jar",
