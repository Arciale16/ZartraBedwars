        },
        {
            "id": "zbw-statistics",
            "path": "statistics/zbw-statistics/pom.xml",
            "packaging": "jar",
            "responsibility": "Java 8 immutable match/player/team/season statistic aggregation and leaderboard foundation"
        },
        {
            "id": "zbw-replay-api",
            "path": "replay/zbw-replay-api/pom.xml",
            "packaging": "jar",
