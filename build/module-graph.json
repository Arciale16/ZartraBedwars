        },
        {
            "id": "zbw-integration-placeholderapi",
            "path": "integrations/placeholderapi/zbw-integration-placeholderapi/pom.xml",
            "packaging": "jar",
            "responsibility": "optional Paper lifecycle bridge and neutral placeholder expansion wiring"
        },
        {
            "id": "zbw-compat-api",
