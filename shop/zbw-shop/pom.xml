<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.zartra.bedwars</groupId>
    <artifactId>zartrabedwars-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>zbw-shop</artifactId>
  <name>ZartraBedWars Shop Application</name>
  <description>Java 8 platform-neutral shop catalogue, quote and atomic purchase application.</description>
  <dependencies>
    <dependency><groupId>io.zartra.bedwars</groupId><artifactId>zbw-api</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.zartra.bedwars</groupId><artifactId>zbw-domain</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.zartra.bedwars</groupId><artifactId>zbw-application</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.zartra.bedwars</groupId><artifactId>zbw-storage-api</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.zartra.bedwars</groupId><artifactId>zbw-compat-api</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.zartra.bedwars</groupId><artifactId>zbw-arena</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.zartra.bedwars</groupId><artifactId>zbw-game</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.zartra.bedwars</groupId><artifactId>zbw-scripting-api</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>${junit.version}</version><scope>test</scope></dependency>
  </dependencies>
  <profiles><profile><id>quality</id><build><plugins><plugin>
    <groupId>org.jacoco</groupId><artifactId>jacoco-maven-plugin</artifactId>
    <executions><execution><id>shop-coverage-check</id><phase>verify</phase><goals><goal>check</goal></goals><configuration><rules><rule><element>BUNDLE</element><limits>
      <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.85</minimum></limit>
      <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.75</minimum></limit>
    </limits></rule></rules></configuration></execution></executions>
  </plugin></plugins></build></profile></profiles>
</project>
