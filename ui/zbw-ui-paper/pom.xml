<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>io.zartra.bedwars</groupId><artifactId>zartrabedwars-parent</artifactId><version>0.1.0-SNAPSHOT</version><relativePath>../../pom.xml</relativePath></parent>
  <artifactId>zbw-ui-paper</artifactId>
  <name>ZartraBedWars Paper UI Adapter</name>
  <description>Java 21 Paper inventory rendering, input translation and lifecycle cleanup.</description>
  <properties><maven.compiler.source>21</maven.compiler.source><maven.compiler.target>21</maven.compiler.target></properties>
  <dependencies>
    <dependency><groupId>io.zartra.bedwars</groupId><artifactId>zbw-ui-api</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.zartra.bedwars</groupId><artifactId>zbw-command-api</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.zartra.bedwars</groupId><artifactId>zbw-arena</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.zartra.bedwars</groupId><artifactId>zbw-game</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.zartra.bedwars</groupId><artifactId>zbw-compat-api</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.zartra.mirror.paper</groupId><artifactId>paper-api</artifactId><version>${paper-api-mirror.version}</version><scope>provided</scope></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>${junit.version}</version><scope>test</scope></dependency>
  </dependencies>
  <build><plugins><plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><configuration><compilerArgs combine.self="override"><arg>-Xlint:all,-options,-classfile</arg><arg>-Werror</arg></compilerArgs></configuration></plugin></plugins></build>
  <profiles><profile><id>quality</id><build><plugins><plugin><groupId>org.jacoco</groupId><artifactId>jacoco-maven-plugin</artifactId><configuration><excludes><exclude>io/zartra/bedwars/ui/paper/PaperInventoryReflection*</exclude></excludes></configuration><executions><execution><id>ui-paper-coverage-check</id><phase>verify</phase><goals><goal>check</goal></goals><configuration><rules><rule><element>BUNDLE</element><limits><limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.80</minimum></limit><limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.70</minimum></limit></limits></rule></rules></configuration></execution></executions></plugin></plugins></build></profile></profiles>
</project>
